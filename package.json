{
  "name": "aeemci-studio",
  "private": true,
  "description": "AEEMCI Studio : plateforme de la section AEEMCI ESATIC (génération, documents, validation, activités, archives)",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @aeemci-studio/web",
    "build": "npm run build -w @aeemci-studio/web",
    "lint": "npm run lint -w @aeemci-studio/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "overrides": { "esbuild": "^0.28.2" }
}
