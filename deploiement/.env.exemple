# À copier en `.env` sur le serveur, à côté de compose.yaml (doc 10, section 5). Ne jamais le commiter.

# Adresse publique : l'IP élastique écrite avec des tirets, suivie de .sslip.io (ex. 3-120-45-67.sslip.io),
# ou un vrai nom de domaine pointé sur cette IP.
DOMAINE=3-120-45-67.sslip.io
BETTER_AUTH_URL=https://3-120-45-67.sslip.io

DATABASE_URL=postgresql://…-pooler…/neondb?sslmode=require
# 32 octets aléatoires : openssl rand -base64 32
BETTER_AUTH_SECRET=

STOCKAGE=r2
R2_COMPTE=
R2_CLE=
R2_SECRET=
R2_SEAU=

# Notifications (facultatif, section 7)
# VAPID_PUBLIQUE=
# VAPID_PRIVEE=
# VAPID_CONTACT=mailto:bureau@exemple.ci
# RAPPELS_SECRET=
