# À copier en `.env` sur le serveur, à côté de compose.yaml (doc 10, section 5). Ne jamais le commiter.
# Remplacer CHAQUE valeur entre <…> ; contrôle : `grep -n '<' .env | cut -d= -f1` ne doit rien afficher.

# Adresse publique : l'IP élastique écrite avec des tirets, suivie de .sslip.io (ex. 13-39-112-125.sslip.io),
# ou un vrai nom de domaine pointé sur cette IP.
DOMAINE=<ip-avec-tirets>.sslip.io
BETTER_AUTH_URL=https://<ip-avec-tirets>.sslip.io

DATABASE_URL=<chaîne Neon « pooled » : postgresql://…-pooler…/neondb?sslmode=require>
# 32 octets aléatoires : openssl rand -base64 32
BETTER_AUTH_SECRET=<secret>

STOCKAGE=r2
R2_COMPTE=<Account ID Cloudflare>
R2_CLE=<Access Key ID R2>
R2_SECRET=<Secret Access Key R2>
R2_SEAU=<nom du seau>

# Notifications (facultatif, section 7)
# VAPID_PUBLIQUE=
# VAPID_PRIVEE=
# VAPID_CONTACT=mailto:bureau@exemple.ci
# RAPPELS_SECRET=
