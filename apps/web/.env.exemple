# Copier en .env puis remplir (voir docs/10-deploiement.md).

# Base Postgres : Neon (chaîne « Pooled connection ») ou Postgres local.
DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/aeemci_studio

# Better Auth : 32 caractères aléatoires au moins (ex. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Stockage des fichiers : local par défaut (dossier .stockage). En production : r2.
# STOCKAGE=r2
# R2_COMPTE=
# R2_CLE=
# R2_SECRET=
# R2_SEAU=aeemci-studio

# Notifications (facultatif) : paire de clés générée une fois par `npx web-push generate-vapid-keys`.
# VAPID_PUBLIQUE=
# VAPID_PRIVEE=
# VAPID_CONTACT=mailto:bureau@exemple.ci
# Rappel de la veille des activités : secret attendu par /api/notifications/rappels (planificateur).
# RAPPELS_SECRET=

# Tests : base jetable, VIDÉE à chaque lancement. Sans elle, les tests de base sont sautés.
# TEST_DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/aeemci_test
